; PortGate virtual COM, own UMDF 2 driver. Build/stage only; installation and signing are separate operations.
[Version]
Signature="$Windows NT$"
Class=Ports
ClassGuid={4D36E978-E325-11CE-BFC1-08002BE10318}
Provider=%Provider%
CatalogFile=PortGateVCom.cat
DriverVer=11/01/2026,0.1.0.0
PnpLockdown=1

[Manufacturer]
%Provider%=Devices,NTamd64.10.0...17134,NTamd64.10.0...22000
[Devices.NTamd64.10.0...17134]
%Device%=Install,ROOT\PortGateVCom
[Devices.NTamd64.10.0...22000]
%Device%=Install11,ROOT\PortGateVCom
[DestinationDirs]
DriverCopy=13
[SourceDisksNames]
1=%Media%
[SourceDisksFiles]
PortGateVCom.dll=1
[DriverCopy]
PortGateVCom.dll
[Install.NT]
CopyFiles=DriverCopy
[Install.NT.HW]
AddReg=DeviceSettings
[Install.NT.Services]
AddService=WUDFRd,0x000001fa,Reflector
[Reflector]
DisplayName=%ReflectorName%
ServiceType=1
StartType=3
ErrorControl=1
ServiceBinary=%12%\WUDFRd.sys
[Install.NT.Wdf]
UmdfService=PortGateVCom,DriverSettings
UmdfServiceOrder=PortGateVCom
UmdfKernelModeClientPolicy=AllowKernelModeClients
UmdfFileObjectPolicy=AllowNullAndUnknownFileObjects
UmdfFsContextUsePolicy=CannotUseFsContexts
[Install11.NT]
CopyFiles=DriverCopy
Include=WUDFRD.inf
Needs=WUDFRD.NT
[Install11.NT.HW]
AddReg=DeviceSettings
Include=WUDFRD.inf
Needs=WUDFRD.NT.HW
[Install11.NT.Services]
Include=WUDFRD.inf
Needs=WUDFRD.NT.Services
[Install11.NT.Wdf]
UmdfService=PortGateVCom,DriverSettings
UmdfServiceOrder=PortGateVCom
UmdfKernelModeClientPolicy=AllowKernelModeClients
UmdfFileObjectPolicy=AllowNullAndUnknownFileObjects
UmdfFsContextUsePolicy=CannotUseFsContexts
[DriverSettings]
UmdfLibraryVersion=2.15.0
ServiceBinary=%13%\PortGateVCom.dll
[DeviceSettings]
HKR,,DeviceType,0x00010001,0x0000001b
HKR,,Exclusive,0x00010001,1
HKR,,Security,,"D:P(A;;GA;;;SY)(A;;GA;;;BA)(A;;GRGW;;;IU)(A;;GRGW;;;LS)"
[Strings]
Provider="Kalyx"
Device="PortGate Virtual COM"
Media="PortGate Virtual COM driver"
ReflectorName="Windows Driver Foundation - User-mode Driver Framework Reflector"
