# systemd unit for RemoteUSB on Linux / Raspberry Pi.
# Install: copy the binary to /usr/local/bin, create the user (useradd --system --groups dialout remoteusb),
# copy this file to /etc/systemd/system and run: systemctl enable --now remoteusb
# The state directory /var/lib/remoteusb is created by systemd with mode 0700 for the service user.
# Optional: fix the administering server at installation by adding --server-cert <sha256> or --psk <id>:<hex>.

[Unit]
Description=RemoteUSB - serial ports over the network, administered remotely
After=network-online.target
Wants=network-online.target

[Service]
User=remoteusb
Group=dialout
StateDirectory=remoteusb
StateDirectoryMode=0700
ExecStart=/usr/local/bin/remoteusb run --state /var/lib/remoteusb --admin 0.0.0.0:28240 --quiet
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
