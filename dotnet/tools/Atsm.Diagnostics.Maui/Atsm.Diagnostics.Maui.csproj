<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <OutputType>WinExe</OutputType><UseMaui>true</UseMaui><SingleProject>true</SingleProject>
    <AssemblyName>atsm-diagnostics</AssemblyName><RootNamespace>Atsm.Diagnostics.Maui</RootNamespace>
    <ApplicationTitle>ATSM Diagnóstico</ApplicationTitle><ApplicationId>com.kalyx.atsm.diagnostics</ApplicationId>
    <ApplicationDisplayVersion>0.2.0</ApplicationDisplayVersion><ApplicationVersion>2</ApplicationVersion>
    <WindowsPackageType>None</WindowsPackageType><WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <SelfContained>true</SelfContained><RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <AppendRuntimeIdentifierToOutputPath>false</AppendRuntimeIdentifierToOutputPath>
    <PublishDir>$(MSBuildProjectDirectory)\bin\$(Configuration)\</PublishDir>
    <SupportedOSPlatformVersion>10.0.17763.0</SupportedOSPlatformVersion><TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <PublishTrimmed>false</PublishTrimmed><MauiXamlInflator>SourceGen</MauiXamlInflator>
    <JsonSerializerIsReflectionEnabledByDefault>false</JsonSerializerIsReflectionEnabledByDefault>
    <NeutralLanguage>es-AR</NeutralLanguage><AppXDefaultResourceQualifiers>Language=es-AR</AppXDefaultResourceQualifiers>
    <!-- Official MAUI 10.0.110 DLLs are not strong-named. Keep CS8002 visible, scoped to this
         executable; own assemblies remain signed. Provenance/decision: EDC#205, 2026-10-25. -->
    <WarningsNotAsErrors>$(WarningsNotAsErrors);CS8002</WarningsNotAsErrors>
  </PropertyGroup>
  <ItemGroup>
    <None Include="..\..\..\PortGate\build\win-x64\Release\portgate.exe" Link="portgate.exe" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" Condition="Exists('..\..\..\PortGate\build\win-x64\Release\portgate.exe')" />
    <ProjectReference Include="..\Atsm.Diagnostics.Core\Atsm.Diagnostics.Core.csproj" />
    <PackageReference Include="Microsoft.Maui.Controls" />
    <PackageReference Include="System.Security.Cryptography.ProtectedData" />
    <MauiIcon Include="Resources\AppIcon\appicon.svg" Color="#12313E" />
    <None Update="README.txt" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
  <Import Project="..\..\KalyxLang.props" />
  <Import Project="WindowsLanguages.targets" />
</Project>
