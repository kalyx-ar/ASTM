<Window x:Class="Atsm.Diagnostics.Windows.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="ATSM · Diagnóstico de mantenimiento" Width="1440" Height="920"
 MinWidth="1100" MinHeight="720" Background="#F3F6FA" FontFamily="Segoe UI" Foreground="#1E293B" Closing="OnClosing">
 <Window.Resources>
  <Style TargetType="Button"><Setter Property="Padding" Value="13,8"/><Setter Property="Margin" Value="0,0,8,0"/><Setter Property="Background" Value="#0F766E"/><Setter Property="Foreground" Value="White"/><Setter Property="BorderThickness" Value="0"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.4"/></Trigger><Trigger Property="IsMouseOver" Value="True"><Setter Property="Opacity" Value="0.85"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
  <Style TargetType="TextBox"><Setter Property="Padding" Value="7,5"/><Setter Property="BorderBrush" Value="#CAD5DF"/><Setter Property="Margin" Value="0,4,0,10"/><Setter Property="VerticalContentAlignment" Value="Center"/></Style>
  <Style TargetType="ComboBox"><Setter Property="Padding" Value="6,5"/><Setter Property="Margin" Value="0,4,0,10"/><Setter Property="MinHeight" Value="32"/></Style>
  <Style TargetType="DataGrid"><Setter Property="AutoGenerateColumns" Value="False"/><Setter Property="IsReadOnly" Value="True"/><Setter Property="CanUserAddRows" Value="False"/><Setter Property="HeadersVisibility" Value="Column"/><Setter Property="GridLinesVisibility" Value="Horizontal"/><Setter Property="HorizontalGridLinesBrush" Value="#E6ECF2"/><Setter Property="BorderThickness" Value="0"/><Setter Property="RowHeight" Value="31"/><Setter Property="AlternatingRowBackground" Value="#F8FAFC"/><Setter Property="SelectionMode" Value="Single"/><EventSetter Event="SelectionChanged" Handler="DetailSelected"/></Style>
  <Style TargetType="DataGridColumnHeader"><Setter Property="Background" Value="#EAF0F6"/><Setter Property="Foreground" Value="#43566C"/><Setter Property="Padding" Value="9"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="BorderThickness" Value="0"/></Style>
  <Style TargetType="TabItem"><Setter Property="Padding" Value="13,8"/></Style>
 </Window.Resources>
 <Grid Background="#F3F6FA">
  <Grid.RowDefinitions><RowDefinition Height="76"/><RowDefinition Height="*"/><RowDefinition Height="38"/></Grid.RowDefinitions>
  <Border Background="#12313E" Padding="24,14"><DockPanel>
   <StackPanel DockPanel.Dock="Right" HorizontalAlignment="Right"><TextBlock Text="MANTENIMIENTO" Foreground="#71DCC7" FontSize="11" FontWeight="Bold"/><TextBlock Text="Motor + plugins · Sin dependencia de EDC" Foreground="#BBD0DA" FontSize="12" Margin="0,7,0,0"/></StackPanel>
   <StackPanel><TextBlock Text="ATSM  /  Diagnóstico" Foreground="White" FontSize="25" FontWeight="SemiBold"/><TextBlock Text="Interfaces, logs y exportaciones de instrumentos" Foreground="#BBD0DA" FontSize="12"/></StackPanel>
  </DockPanel></Border>
  <Grid Grid.Row="1" Margin="18"><Grid.ColumnDefinitions><ColumnDefinition Width="310"/><ColumnDefinition Width="16"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
   <Border Background="White" CornerRadius="8" Padding="16"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel>
    <TextBlock Text="FUENTE Y PERFIL" FontSize="11" Foreground="#64748B" FontWeight="Bold"/>
    <TextBlock Text="Plugin / formato" Margin="0,14,0,0"/>
    <ComboBox x:Name="ProfileBox" DisplayMemberPath="DisplayName" SelectionChanged="ProfileChanged"/>
    <TextBlock x:Name="EvidenceText" TextWrapping="Wrap" Foreground="#52677E" FontSize="11" Margin="0,0,0,14"/>
    <TextBlock Text="Entrada de archivo"/>
    <ComboBox x:Name="FormatBox" DisplayMemberPath="Label"/>
    <WrapPanel Margin="0,0,0,14"><Button x:Name="OpenButton" Content="Abrir archivo" Click="OpenFile"/><Button x:Name="SaveButton" Content="Guardar caso" Background="#38576B" Click="SaveCase"/></WrapPanel>
    <TextBlock Text="Los casos se protegen para el usuario Windows actual. Los originales no se modifican." TextWrapping="Wrap" Foreground="#64748B" FontSize="11"/>
    <StackPanel x:Name="InterfacePanel"><Separator Margin="0,18"/>
    <TextBlock Text="INTERFAZ EN VIVO" FontSize="11" Foreground="#64748B" FontWeight="Bold"/>
    <ComboBox x:Name="TransportBox" SelectedIndex="0"><ComboBoxItem Content="TCP · conectar al instrumento"/><ComboBoxItem Content="TCP · esperar al instrumento"/><ComboBoxItem Content="SerialTunnel · agente ATSM"/></ComboBox>
    <TextBlock Text="Host / IP local al escuchar"/><TextBox x:Name="HostBox" Text="127.0.0.1"/>
    <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="12"/><ColumnDefinition/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Puerto TCP"/><TextBox x:Name="PortBox"/></StackPanel><StackPanel Grid.Column="2"><TextBlock Text="Puerto del agente"/><TextBox x:Name="AgentPortBox" Text="p1"/></StackPanel></Grid>
    <TextBlock Text="Identidad del controlador"/><TextBox x:Name="ControllerBox"/>
    <CheckBox x:Name="TlsBox" Content="TLS · sin degradación automática" Margin="0,0,0,12"/>
    <Button Content="Certificado PFX (opcional / mTLS)" Background="#38576B" Click="ChooseCertificate" Margin="0,0,0,5"/>
    <TextBlock x:Name="CertificateText" Text="Sin certificado seleccionado" Foreground="#64748B" FontSize="11" TextWrapping="Wrap"/>
    <PasswordBox x:Name="CertificatePassword" Padding="7,5" Margin="0,6,0,12" ToolTip="Contraseña del PFX; no se guarda en el caso"/>
    <TextBlock Text="Modo de protocolo"/>
    <ComboBox x:Name="ModeBox" SelectedIndex="0"><ComboBoxItem Content="Capturar sin responder"/><ComboBoxItem Content="Simular host: ACK, sin órdenes"/></ComboBox>
    <TextBlock Text="La captura abre una conexión propia. SerialTunnel toma control exclusivo; no observa otra sesión." TextWrapping="Wrap" Foreground="#64748B" FontSize="11" Margin="0,0,0,12"/>
    <TextBlock Text="Presupuestos HL7 del equipo (segundos)" FontSize="11"/>
    <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="12"/><ColumnDefinition/></Grid.ColumnDefinitions><TextBox x:Name="QueryBudgetBox" ToolTip="Plazo de consulta configurado en el equipo"/><TextBox Grid.Column="2" x:Name="ResponseBudgetBox" ToolTip="Plazo de respuesta configurado en el equipo"/></Grid>
    <TextBlock Text="Offset UTC de logs (±hh:mm)" FontSize="11"/><TextBox x:Name="OffsetBox" Text="-03:00"/>
    <WrapPanel><Button x:Name="ConnectButton" Content="Conectar" Click="Connect"/><Button x:Name="StopButton" Content="Detener" Background="#9F4452" IsEnabled="False" Click="Stop"/></WrapPanel>
    </StackPanel>
   </StackPanel></ScrollViewer></Border>
   <Grid Grid.Column="2"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="150"/></Grid.RowDefinitions>
    <Border Background="White" CornerRadius="8" Padding="18,13" Margin="0,0,0,12"><DockPanel><Button Content="Ejemplo CFX" Click="Demo" Background="#38576B" DockPanel.Dock="Right"/><StackPanel><TextBlock x:Name="CaseTitle" Text="Sin caso abierto" FontSize="19" FontWeight="SemiBold"/><TextBlock x:Name="SummaryText" Text="Elegí un perfil y abrí un archivo o conectá una interfaz." Foreground="#64748B" Margin="0,6,0,0" TextWrapping="Wrap"/></StackPanel></DockPanel></Border>
    <TabControl Grid.Row="1" BorderThickness="0" Background="White">
     <TabItem Header="Trama"><Grid><Grid.RowDefinitions><RowDefinition Height="35"/><RowDefinition/></Grid.RowDefinitions><CheckBox x:Name="HexBox" Content="Hexadecimal" Margin="12,8" Checked="HexChanged" Unchecked="HexChanged"/><DataGrid x:Name="TraceGrid" Grid.Row="1"><DataGrid.Columns><DataGridTextColumn Header="#" Binding="{Binding Sequence}" Width="55"/><DataGridTextColumn Header="ms" Binding="{Binding Milliseconds}" Width="80"/><DataGridTextColumn Header="Dir." Binding="{Binding Direction}" Width="75"/><DataGridTextColumn Header="Bytes" Binding="{Binding Length}" Width="70"/><DataGridTextColumn Header="Código / contenido" Binding="{Binding Preview}" Width="*"/></DataGrid.Columns></DataGrid></Grid></TabItem>
     <TabItem Header="Mensajes"><DataGrid x:Name="MessagesGrid"><DataGrid.Columns><DataGridTextColumn Header="#" Binding="{Binding Sequence}" Width="60"/><DataGridTextColumn Header="Dirección" Binding="{Binding Direction}" Width="115"/><DataGridTextColumn Header="Tipo" Binding="{Binding Type}" Width="140"/><DataGridTextColumn Header="Contenido" Binding="{Binding Text}" Width="*"/></DataGrid.Columns></DataGrid></TabItem>
     <TabItem Header="Observaciones" IsSelected="True"><DataGrid x:Name="ObservationsGrid"><DataGrid.Columns><DataGridTextColumn Header="Muestra" Binding="{Binding Sample}" Width="140"/><DataGridTextColumn Header="Posición" Binding="{Binding Well}" Width="85"/><DataGridTextColumn Header="Prueba / target" Binding="{Binding Test}" Width="145"/><DataGridTextColumn Header="Tipo" Binding="{Binding Kind}" Width="85"/><DataGridTextColumn Header="Valor original" Binding="{Binding Value}" Width="125"/><DataGridTextColumn Header="Unidad" Binding="{Binding Unit}" Width="90"/><DataGridTextColumn Header="Estado / flags" Binding="{Binding Status}" Width="220"/></DataGrid.Columns></DataGrid></TabItem>
     <TabItem Header="Hallazgos"><DataGrid x:Name="FindingsGrid"><DataGrid.Columns><DataGridTextColumn Header="Nivel" Binding="{Binding Severity}" Width="100"/><DataGridTextColumn Header="Código" Binding="{Binding Code}" Width="270"/><DataGridTextColumn Header="Detalle" Binding="{Binding Message}" Width="*"/></DataGrid.Columns></DataGrid></TabItem>
     <TabItem Header="Eventos"><DataGrid x:Name="EventsGrid"><DataGrid.Columns><DataGridTextColumn Header="Capa" Binding="{Binding Level}" Width="110"/><DataGridTextColumn Header="#" Binding="{Binding Sequence}" Width="60"/><DataGridTextColumn Header="Código" Binding="{Binding Code}" Width="250"/><DataGridTextColumn Header="Detalle" Binding="{Binding Detail}" Width="*"/></DataGrid.Columns></DataGrid></TabItem>
     <TabItem Header="Catálogo"><DataGrid x:Name="CatalogGrid"><DataGrid.Columns><DataGridTextColumn Header="Marca" Binding="{Binding Manufacturer}" Width="100"/><DataGridTextColumn Header="Perfil" Binding="{Binding Name}" Width="230"/><DataGridTextColumn Header="Formato" Binding="{Binding Protocol}" Width="110"/><DataGridTextColumn Header="Evidencia / alcance" Binding="{Binding Evidence}" Width="*"/></DataGrid.Columns></DataGrid></TabItem>
    </TabControl>
    <Border Grid.Row="2" Background="#132632" CornerRadius="6" Margin="0,12,0,0" Padding="12"><DockPanel><TextBlock DockPanel.Dock="Top" Text="DETALLE SELECCIONADO" Foreground="#7CCDBD" FontSize="10" FontWeight="Bold"/><TextBox x:Name="DetailBox" Text="Seleccioná una trama, mensaje u observación para inspeccionarla." Background="Transparent" Foreground="#D7E7EF" FontFamily="Consolas" FontSize="12" BorderThickness="0" IsReadOnly="True" AcceptsReturn="True" TextWrapping="NoWrap" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"/></DockPanel></Border>
   </Grid>
  </Grid>
  <Border Grid.Row="2" Background="#E3EBF2" Padding="22,10"><TextBlock x:Name="StatusText" Text="Listo · Los resultados de diagnóstico no se publican en un LIMS." FontSize="12"/></Border>
 </Grid>
</Window>
