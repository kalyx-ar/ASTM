<Project>
  <PropertyGroup>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier><SelfContained>true</SelfContained>
    <PublishAot>true</PublishAot><JsonSerializerIsReflectionEnabledByDefault>false</JsonSerializerIsReflectionEnabledByDefault>
    <PublishDir>$(MSBuildProjectDirectory)\bin\$(Configuration)\Native\</PublishDir>
  </PropertyGroup>
</Project>
