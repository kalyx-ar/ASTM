<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <AssemblyName>atsm-trace</AssemblyName>
    <RootNamespace>Atsm.Tools.Trace</RootNamespace>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>atsm-trace</ToolCommandName>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <AppendRuntimeIdentifierToOutputPath>false</AppendRuntimeIdentifierToOutputPath>
    <InvariantGlobalization>true</InvariantGlobalization>
    <Description>Import, anonymize, summarize and interpret ATSM traces.</Description>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\Atsm.Diagnostics.Core\Atsm.Diagnostics.Core.csproj" />
    <ProjectReference Include="..\..\src\Atsm.Tracing\Atsm.Tracing.csproj" />
    <ProjectReference Include="..\..\src\Atsm.Channels\Atsm.Channels.csproj" />
    <ProjectReference Include="..\..\src\Atsm.Testing\Atsm.Testing.csproj" />
    <ProjectReference Include="..\..\plugins\Atsm.Plugin.Abbott.Architect\Atsm.Plugin.Abbott.Architect.csproj" />
    <ProjectReference Include="..\..\plugins\Atsm.Plugin.Sysmex.Urinalysis\Atsm.Plugin.Sysmex.Urinalysis.csproj" />
    <ProjectReference Include="..\..\plugins\Atsm.Plugin.Legacy.Testing\Atsm.Plugin.Legacy.Testing.csproj" />
    <ProjectReference Include="..\..\plugins\Atsm.Plugin.Abbott.CellDynRuby\Atsm.Plugin.Abbott.CellDynRuby.csproj" />
  </ItemGroup>
</Project>
