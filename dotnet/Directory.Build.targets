<Project>
  <!--
    Strong Name. ASTM ships signed with the key of the distribution that hosts it; for EDC that is the existing
    Kalyx.EDC.snk. The key never lives in this repository: it is found next to an EDC checkout that contains ASTM
    (EDC/LIMS/ASTM) or given with -p:AstmStrongNameKeyFile=<path>. Without a key the build is unsigned, unless
    AstmRequireStrongName=true (release builds), which fails instead. Authenticode is applied at release time.
    Also stops MSBuild from importing the targets of a containing repository.
  -->
  <PropertyGroup>
    <_AstmEdcKey>$([MSBuild]::NormalizePath('$(MSBuildThisFileDirectory)', '..', '..', '..', 'EDC', 'Build', 'Signing', 'Kalyx.EDC.snk'))</_AstmEdcKey>
    <AstmStrongNameKeyFile Condition="'$(AstmStrongNameKeyFile)' == '' and Exists('$(_AstmEdcKey)')">$(_AstmEdcKey)</AstmStrongNameKeyFile>
  </PropertyGroup>
  <PropertyGroup Condition="'$(AstmStrongNameKeyFile)' != '' and '$(IsTestProject)' != 'true'">
    <SignAssembly>true</SignAssembly>
    <AssemblyOriginatorKeyFile>$(AstmStrongNameKeyFile)</AssemblyOriginatorKeyFile>
  </PropertyGroup>
  <Target Name="AstmRequireStrongName" BeforeTargets="CoreCompile" Condition="'$(AstmRequireStrongName)' == 'true' and '$(IsTestProject)' != 'true'">
    <Error Condition="'$(SignAssembly)' != 'true' or !Exists('$(AssemblyOriginatorKeyFile)')" Text="ASTM release builds must be strong-named: provide the existing distribution key with -p:AstmStrongNameKeyFile=&lt;path&gt;. Do not generate a new key." />
  </Target>
</Project>
