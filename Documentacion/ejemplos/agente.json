{
  "schemaVersion": "proposal-1",
  "exampleOnly": true,
  "enabled": false,
  "agentId": "bridge-sintetico-01",
  "platformProfile": "windows-desktop",
  "endpoints": [
    {
      "id": "instrumento-sintetico-01",
      "role": "Listen",
      "host": "0.0.0.0",
      "port": 28241,
      "transport": "Tcp",
      "protocol": "ManagedSerialTunnel",
      "portId": "serial-01",
      "tls": {
        "mode": "Tls",
        "minimumVersion": "TLS1.2",
        "requireClientCertificate": true,
        "certificateRef": "<certificado-del-agente>",
        "privateKeyRef": "<clave-del-agente>",
        "trustedControllerCaRef": "<CA-de-controladores-EDC>",
        "expectedServerIdentity": "bridge-01.example.invalid"
      }
    }
  ],
  "serialPorts": [
    {
      "portId": "serial-01",
      "instrumentId": "instrumento-sintetico-01",
      "device": "COM3",
      "baudRate": 9600,
      "dataBits": 8,
      "parity": "None",
      "stopBits": 1,
      "flowControl": "None",
      "whenUnowned": "CaptureBounded",
      "ownership": {
        "exclusive": true,
        "leaseDurationMs": 15000,
        "renewIntervalMs": 5000,
        "maxQueuedRequests": 16,
        "queuePolicy": "PriorityThenFifo",
        "preemptActiveOwner": false,
        "controllers": [
          { "id": "edc-server-a", "priority": 10 },
          { "id": "edc-server-b", "priority": 20 },
          { "id": "edc-cliente-local", "priority": 100 }
        ]
      },
      "buffers": {
        "rxBytes": 65536,
        "txBytes": 65536,
        "maxManagedRecordBytes": 16384,
        "forwardAvailableBytes": true,
        "onOverflow": "FaultAndReport"
      },
      "trace": {
        "capture": "Durable",
        "locationRef": "<directorio-de-trazas>",
        "maxBytes": 67108864,
        "retentionHours": 24,
        "reportGaps": true
      }
    }
  ]
}
